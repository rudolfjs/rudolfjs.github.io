{
  "name": "rudolfjs.github.io",
  "private": true,
  "description": "Rudolf J profile hosted using GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm run build && npm test",
    "audit:npm": "npm audit --audit-level=low",
    "audit:signatures": "npm audit signatures",
    "audit:osv": "sh scripts/osv-scan.sh",
    "security": "npm run audit:npm && npm run audit:signatures && npm run audit:osv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudolfjs/rudolfjs.github.io.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rudolfjs/rudolfjs.github.io/issues"
  },
  "homepage": "https://rudolfjs.id.au",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "astro": "7.3.8",
    "husky": "9.1.7",
    "typescript": "6.0.3"
  }
}
